generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model historico_status_reserva {
  historico_status_reserva_id              BigInt    @id @default(autoincrement())
  reserva_id                               BigInt
  historico_status_reserva_status_anterior Int?
  historico_status_reserva_status_novo     Int?
  historico_status_reserva_alterado_em     DateTime? @default(now()) @db.DateTime(0)
  historico_status_reserva_alterado_por    BigInt?
  historico_status                         Int?

  @@index([historico_status_reserva_alterado_por], map: "alterado_por_idx")
  @@index([reserva_id], map: "reserva_id_idx")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model reserva {
  reserva_id                      BigInt    @id @default(autoincrement())
  usuario_id                      BigInt
  reserva_veiculo_id              BigInt
  reserva_retirada_prevista       DateTime  @default(now()) @db.DateTime(0)
  reserva_devolucao_prevista      DateTime  @default(now()) @db.DateTime(0)
  reserva_retirada_real           DateTime? @default(now()) @db.DateTime(0)
  reserva_devolucao_real          DateTime? @default(now()) @db.DateTime(0)
  reserva_quilometragem_retirada  Int?
  reserva_quilometragem_devolucao Int?
  reserva_valor_estimado          Decimal?  @db.Decimal(10, 2)
  reserva_criada                  DateTime  @default(now()) @db.DateTime(0)
  reserva_atualizada              DateTime  @default(now()) @db.DateTime(0)
  reserva_cancelada               DateTime? @default(now()) @db.DateTime(0)
  reserva_status                  Int

  @@index([usuario_id], map: "usuario_id_idx")
}

model usuario {
  usuario_id              BigInt    @id @default(autoincrement())
  usuario_nome            String?   @db.VarChar(155)
  usuario_cpf             String?   @db.VarChar(11)
  usuario_email           String?   @unique(map: "usuario_email_UNIQUE") @db.VarChar(150)
  usuario_senha           String?   @db.VarChar(255)
  usuario_telefone        String?   @db.VarChar(20)
  usuario_data_nascimento DateTime? @default(now()) @db.Date
  usuario_numero_cnh      String?   @db.VarChar(45)
  usuario_validade_cnh    DateTime? @default(now()) @db.Date
  usuario_tipo            Int?
  usuario_criado_em       DateTime? @default(now()) @db.DateTime(0)
  usuario_atualizado_em   DateTime? @default(now()) @db.DateTime(0)
  usuario_status          Int?
}
